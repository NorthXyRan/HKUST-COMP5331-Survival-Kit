# Keep this repository in the existing study folder; track only the categories below.
/*
!/.gitignore
!/README.md
!/Hw/
!/Slides/
!/Exams/

# Homework: original question papers and reference solutions, grouped by semester.
/Hw/**
!/Hw/*/
!/Hw/*/hw[0-9]*.pdf
!/Hw/*/README.md

# Original lecture slides. The named PPTX is an existing local conversion of the PPT.
/Slides/**
!/Slides/*.ppt
!/Slides/*.pptx
!/Slides/*.pdf
!/Slides/README.md
/Slides/otherClustering.pptx

# Past-exam PDFs, either here or in a semester subfolder.
/Exams/**
!/Exams/**/
!/Exams/**/*.pdf

# Finder metadata and Office lock files are always local.
.DS_Store
._*
~$*
*.tmp
*.temp
